# Required GitHub App credentials and target repository
GITHUB_APP_ID=
# Path to your GitHub App PEM file on the host (use forward slashes on Windows).
GITHUB_APP_PRIVATE_KEY=C:/Users/you/keys/github-app.pem
GITHUB_REPOSITORY=owner/repository

# Configure the API key(s) required by the model(s) selected in your settings
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Configure the API key for TypeSafe JEV system Model selected in your settings
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=

# Configure the API key(s) for langsmith to trace the project execution
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# models selection based on the agents or task
CODER_MODEL=deepseek/deepseek-chat
FAST_MODEL=groq/llama-3.3-70b-versatile
FALLBACK_MODEL=openai/gpt-4o-mini
MAX_BUDGET_PER_ISSUE_USD=0.25